"use strict";
var largeImg = document.querySelector("#largeImg");
var thumbs = document.querySelector("#thumbs");
thumbs.addEventListener("click", function(events) {
    var link = events.target.closest(".list-item__link");
    if (!link) return;
    events.preventDefault();
    largeImg.src = link.href;
    largeImg.alt = link.title;
});

